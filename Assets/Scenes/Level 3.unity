  m_Script: {fileID: 11500000, guid: b6c9560b814b0204ba48d81bec530204, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CodeBreaker.Level3.L3Keypad
  displayName: Laptop
  station: m1
  title: RAMOS'S LAPTOP
  code: '<color=#9A918A>// RAMOS - job 1 of 3. Finish it for me.

    // My three
    lockers are my variables:

    //    name  = the label on the door

    //   
    value = the number on the card inside

    // ''='' puts a COPY of the value
    on the right

    //    into the variable on the left.</color>


    locker2
    = locker1;

    locker1 = locker3;


    <color=#9A918A>// Run the lines in order,
    top to bottom.

    // What number is in locker2 now?</color>


    <color=#E8C547>Lockers
    you have opened:</color>

    {lockers}'
  answer: 8
  symbolKeys: 0
  maxLength: 3
  hint: Write all three locker values down. After each line, change ONLY the locker
    on the left of '='.
  penalty: 10
  wrongMessage: 
  requiredFlags: []
  lockedMessage: It doesn't respond.
  successDisplay: 8
  successMessage: locker2 kept 8. Copying a value doesn't link the boxes.
  verb: Use
  onSolved: []
  screen: {fileID: 0}
  screenLocked: 
  screenReady: 
  screenSolved: 
