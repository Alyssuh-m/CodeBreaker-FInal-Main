  displayName: Symbol Keypad
  station: s2
  title: CABINET LOCK
  code: 'The cabinet only takes operators.

    Enter the three missing symbols from
    the last shift log, in order.


    Keys:   +   -   *   /   %'
  answer: '%*/'
  symbolKeys: 1
  maxLength: 3
  hint: '% gives what is LEFT OVER after dividing.'
  penalty: 10
  wrongMessage: BZZT. The keypad buzzes and clears.  -10 s
