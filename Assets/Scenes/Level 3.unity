  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ccc8b208596730143a687c16473d152c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CodeBreaker.Level2.L2Examine
  displayName: Notebook
  title: RAMOS'S NOTEBOOK
  body: 'Day 1 - The doors won''t open. Radio is dead. Someone will come.

    Day
    3 - Sleeping at the guard post. The cameras still work, so I watch them.

    Day
    5 - Someone on CAM 4, standing in an aisle. When I go out there, nobody.

    Day
    6 - It stands like me. Same height. Same jacket.

    Day 8 - I stopped going
    out to check. Every night it is a little closer on the screen.

    Day 9 - I
    left the keycards behind my three jobs, one in each wing. Whoever comes next
    can earn them back and put them in the terminal. I can''t do it anymore.'
  image: {fileID: 0}
  verb: Read Ramos's Notebook
  flagOnRead: 
