%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3c007d73d280db54796fdf83d0d8f2d6, type: 3}
  m_Name: LevelCatalog
  m_EditorClassIdentifier: Assembly-CSharp::LevelCatalog
  mainMenuScene: MainMenu
  levels:
  - sceneName: Level 1
    label: LEVEL 1
    title: The Holding Rooms
    description: 'Three sealed rooms stand between you and the exit. Read the question
      on each lectern, then choose a door. The wrong one leads into fire.

      <color=#9A2A22>5:00
      on the clock.</color>'
    loadingImage: {fileID: 21300000, guid: 88e69bb46f4aa924cafe3e7657da8e7c, type: 3}
    playable: 1
  - sceneName: Level 2
    label: LEVEL 2
    title: The Family House
    description: 'LIVING ROOM, BEDROOM, KITCHEN, AND STUDY ROOM

      A quiet family
      home with every door locked. Solve each room''s puzzle to find the key to the
      next one.


      <color=#9A2A22>30:00 on the clock.</color>'
    loadingImage: {fileID: 21300000, guid: 823491c83fb0ebe4eb8f5a8d5abff2ae, type: 3}
    playable: 1
  - sceneName: Level 3
    label: LEVEL 3
    title: Server Room
    description: 'The facility is in lockdown. Search the Maintenance, Security and
      Control rooms for three keycards, then crack the central terminal to open the
      exit.

      <color=#9A2A22>40:00 on the clock.</color>'
    loadingImage: {fileID: 21300000, guid: bc04a443dc9165544b1ec5d6cb906683, type: 3}
    playable: 1
  loadingTips:
  - Each room's lectern holds the question. Stand close and press E to read it.
  - A wrong door costs health, and the clock keeps running.
  - The answer above each door changes every time a room gives you a new question.
  - Press Tab during play to change the music and sound effects volume.
  - Your progress is saved automatically every time you reach a new level.
